# --- Open-source corroboration (the hackathon integration) -------------------
# SerpApi turns a detection into a case: live, structured web search for
# NOTAMs, authority advisories and reporting that confirm — or innocently
# explain — what the telemetry is showing.  https://serpapi.com
SERPAPI_KEY=

# Search recency for corroboration: d = 24h, w = 7d, m = 30d
CORROBORATE_WINDOW=w

# --- Optional: narrative + Q&A layer ----------------------------------------
# Any OpenAI-compatible endpoint. Leave blank to run fully deterministic.
# Point at a local Ollama for air-gapped operation.
LLM_ENABLED=0
AZURE_INFERENCE_KEY=

# --- Optional: aircraft feed --------------------------------------------------
# Public aggregators are used by default and need no key. OpenSky OAuth2
# credentials raise the rate limit if you have them.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Optional: persistence ----------------------------------------------------
# Without GridDB the evidence ledger runs in-memory; the demo works either way.
GRIDDB_USER=
GRIDDB_PASSWORD=
