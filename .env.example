# --- Document generation (hackathon integration) ------------------------------
# Nutrient DWS Processor API turns the case file into a PDF carrying its own
# SHA-256 integrity digest.  https://www.nutrient.io/api/
# Without a key the report is served as printable HTML — the case is never
# withheld because a third-party service is unavailable.
NUTRIENT_API_KEY=

# --- Corroboration ------------------------------------------------------------
# NOAA space weather needs no key and is always on: it is the natural-cause
# check that stops a geomagnetic storm being reported as jamming.
# The FAA NOTAM API is optional and adds official interference notices.
FAA_CLIENT_ID=
FAA_CLIENT_SECRET=

# --- Optional: narrative + Q&A layer -----------------------------------------
# Any OpenAI-compatible endpoint. Leave blank to run fully deterministic.
# Point at a local Ollama for air-gapped operation.
LLM_ENABLED=0
AZURE_INFERENCE_KEY=

# --- Optional: aircraft feed --------------------------------------------------
# Public aggregators are used by default and need no key.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Optional: persistence ----------------------------------------------------
# Without GridDB the evidence ledger runs in-memory; the demo works either way.
GRIDDB_USER=
GRIDDB_PASSWORD=
